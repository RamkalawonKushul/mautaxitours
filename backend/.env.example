# Rails API / PostgreSQL
RAILS_ENV=development
DATABASE_URL=postgresql://localhost/mautaxi_development
SECRET_KEY_BASE=generate-a-long-random-secret-for-each-environment
FORCE_SSL=false
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Optional SMTP. Booking emails remain disabled until SMTP_ADDRESS is configured.
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_DOMAIN=mautaxitours.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
MAILER_FROM=bookings@mautaxitours.com
ADMIN_NOTIFICATION_EMAIL=
APP_HOST=www.mautaxitours.com

# Create/update an administrator with:
# ADMIN_EMAIL=admin@example.com ADMIN_PASSWORD='a-long-unique-password' bin/rails admin:create
